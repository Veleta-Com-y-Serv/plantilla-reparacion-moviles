---
// Ficha de un elemento con `detalle` (src/lib/paginas.ts, listas de src/data/fichas.ts): /reparaciones/<slug>/.
// Diseño «banco de pruebas»: banda negra con rejilla de puntos verdes, migas y hero partido (aparato en chip, título
// grande, texto, tiempo y precio en monoespaciada neón, botones de presupuesto y WhatsApp; a la derecha la foto con
// marco de línea verde o, sin foto, el icono del aparato en grande); banda clara con el `detalle` y, al lado, la tabla
// técnica de datos y la caja neón de presupuesto; galería (`imagenes`) en banda grafito; y otras reparaciones en
// banda clara con puntos tenues.
import Base from '../../layouts/Base.astro';
import Imagen from '../../components/ui/Imagen.astro';
import Icono from '../../components/ui/Icono.astro';
import Titular from '../../components/ui/Titular.astro';
import { clave, seccion, site, tel, whatsapp } from '../../data/site';
import { fichas, relacionadas, resumen } from '../../lib/paginas';
import type { Ficha } from '../../lib/paginas';
import { altGaleria, jsonLdFicha, jsonLdMigas, urlBase } from '../../lib/seo';
import { enlace, rutaDeSeccion } from '../../lib/multipagina';

export function getStaticPaths() {
  return fichas().map((f) => ({ params: { coleccion: f.def.ruta, slug: f.slug }, props: { f } }));
}

interface Props { f: Ficha }
const { f } = Astro.props;
const base = urlBase(Astro.site);
const nombreSeccion = String(f.seccion.antetitulo || f.seccion.titulo || f.def.nombre).trim();
const migas = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: nombreSeccion, ruta: rutaDeSeccion(f.idSeccion) },
  { nombre: f.titulo, ruta: f.url },
];
const c = site.contacto;
const presupuesto = seccion('presupuesto') ? enlace('/#presupuesto') : site.boton_cabecera?.url || enlace('/#contacto');
const textoPresupuesto = site.boton_cabecera?.texto || 'Pedir presupuesto';
const wa = whatsapp(c.whatsapp, `Hola, quiero información sobre ${f.titulo}`);
const ICONOS: Record<string, string> = { movil: 'movil', tablet: 'tablet', portatil: 'portatil', ordenador: 'portatil', consola: 'consola' };
const iconoDe = (d?: string) => ICONOS[clave(d)] ?? 'chip';
const dispositivo = String(f.elemento.dispositivo ?? '');
const tiempo = f.datos.find((d) => d.clave === 'tiempo')?.valor ?? '';
const datos = f.datos.filter((d) => d.clave !== 'precio' && d.clave !== 'tiempo');
const icono = f.icono || iconoDe(dispositivo);
const otras = relacionadas(f, 3);
const descripcion = resumen(f.texto || f.detalle[0] || '');
---

<Base titulo={f.titulo} descripcion={descripcion} imagen={f.imagen} ld={[jsonLdMigas(base, migas), jsonLdFicha(base, f)]}>
  <section class="banda-negra puntos ficha-cabeza">
    <div class="contenedor">
      <nav aria-label="Migas de pan" class="migas">
        <ol>
          {migas.map((m, i) => (
            <li>{i < migas.length - 1 ? <a href={m.ruta}>{m.nombre}</a> : <span aria-current="page">{m.nombre}</span>}</li>
          ))}
        </ol>
      </nav>
      <div class:list={['ficha-hero', { 'ficha-hero--sin-foto': !f.imagen }]}>
        <div class="ficha-hero-texto">
          <p class="antetitulo">{f.categoria || dispositivo || f.def.nombre}</p>
          <h1 class="titulo-seccion">{f.titulo}</h1>
          {f.texto && <p class="titular-texto">{f.texto}</p>}
          {(tiempo || f.precio) && (
            <p class="ficha-chips">
              {tiempo && <span class="chip ficha-tiempo"><Icono nombre="reloj" tam={14} /> {tiempo}</span>}
              {f.precio && <span class="ficha-precio num">{f.precio}</span>}
            </p>
          )}
          <div class="ficha-botones">
            <a class="btn" href={presupuesto}>{textoPresupuesto}</a>
            {wa && <a class="btn-sec" href={wa} target="_blank" rel="noopener"><Icono nombre="whatsapp" tam={18} /> WhatsApp</a>}
          </div>
        </div>
        {f.imagen ? (
          <div class="ficha-foto">
            <Imagen src={f.imagen} alt={f.titulo} ancho={1200} alto={900} prioridad class="h-full w-full object-cover" />
          </div>
        ) : (
          <div class="ficha-icono" aria-hidden="true"><Icono nombre={icono} tam={96} /></div>
        )}
      </div>
    </div>
  </section>

  <section class="banda-clara seccion">
    <div class="contenedor ficha-cuerpo">
      <article class="texto-largo ficha-detalle">
        {f.detalle.map((p) => <p>{p}</p>)}
      </article>
      <aside class="ficha-lado">
        {(datos.length > 0 || f.precio || tiempo) && (
          <div class="ficha-datos">
            <h2 class="ficha-lado-titulo antetitulo">Ficha técnica</h2>
            <dl>
              {f.precio && <div><dt>Precio</dt><dd class="num">{f.precio}</dd></div>}
              {tiempo && <div><dt>Tiempo</dt><dd>{tiempo}</dd></div>}
              {datos.map((d) => <div><dt>{d.etiqueta}</dt><dd>{d.valor}</dd></div>)}
            </dl>
          </div>
        )}
        <div class="ficha-caja banda-neon">
          <p class="ficha-caja-titulo">¿Te lo miramos?</p>
          <p>Diagnóstico gratis y precio cerrado antes de tocar nada.</p>
          <a class="btn btn-negro" href={presupuesto}>{textoPresupuesto}</a>
          {c.telefono && <a class="ficha-tel" href={tel(c.telefono)}><Icono nombre="telefono" tam={18} /> {c.telefono}</a>}
        </div>
      </aside>
    </div>
  </section>

  {f.imagenes.length > 0 && (
    <section class="banda-grafito seccion" aria-label={`Fotos de ${f.titulo}`}>
      <div class="contenedor">
        <ul class="ficha-galeria">
          {f.imagenes.map((src, i) => (
            <li><Imagen src={src} alt={`${f.titulo}: ${altGaleria(i).toLowerCase()}`} ancho={800} alto={600} class="h-full w-full object-cover" /></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {otras.length > 0 && (
    <section class="banda-clara puntos-claros seccion">
      <div class="contenedor">
        <Titular antetitulo={nombreSeccion} titulo="Otras reparaciones" />
        <ul class="ficha-otras">
          {otras.map((o) => (
            <li class="ficha-otra">
              <span class="ficha-otra-icono"><Icono nombre={o.icono || iconoDe(String(o.elemento.dispositivo ?? ''))} tam={22} /></span>
              <h3><a href={o.url} class="ficha-otra-enlace">{o.titulo}</a></h3>
              {o.texto && <p class="ficha-otra-texto">{o.texto}</p>}
              <p class="ficha-otra-pie">
                {o.precio && <span class="num">{o.precio}</span>}
                <span class="ficha-otra-ver" aria-hidden="true">Ver <Icono nombre="flecha" tam={16} /></span>
              </p>
            </li>
          ))}
        </ul>
        <p class="mt-10"><a class="btn btn-negro" href={rutaDeSeccion(f.idSeccion)}>Ver todas las reparaciones</a></p>
      </div>
    </section>
  )}
</Base>

<style>
  .ficha-cabeza { padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(3rem, 6vw, 5rem); }
  .migas ol { display: flex; flex-wrap: wrap; gap: .25rem .5rem; font-family: var(--fuente-mono); font-size: .8rem; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; }
  .migas li { display: inline-flex; align-items: center; gap: .5rem; min-width: 0; }
  .migas li + li::before { content: "/"; color: var(--c-primario); }
  .migas a { color: var(--c-primario); text-decoration: none; min-height: 2.75rem; display: inline-flex; align-items: center; }
  .migas a:hover { text-decoration: underline; }
  .migas [aria-current] { opacity: .7; overflow-wrap: anywhere; }
  .ficha-hero { display: grid; gap: 2.5rem; margin-top: clamp(1rem, 3vw, 2.5rem); align-items: center; }
  .ficha-hero-texto .titulo-seccion { font-size: clamp(2.2rem, 6vw, 4.25rem); overflow-wrap: anywhere; }
  .ficha-hero-texto .titular-texto { margin-top: 1.25rem; max-width: 36rem; opacity: .85; }
  .ficha-chips { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1.25rem; margin-top: 1.5rem; }
  .ficha-tiempo { color: var(--c-primario); }
  .ficha-precio { font-size: 1.6rem; color: var(--c-primario); }
  .ficha-botones { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .ficha-botones a { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; }
  .ficha-foto { aspect-ratio: 4 / 3; border-radius: var(--radio); overflow: hidden; border: 1px solid color-mix(in srgb, var(--c-primario) 55%, transparent); box-shadow: 0 0 40px var(--brillo); }
  .ficha-icono { display: grid; place-items: center; aspect-ratio: 4 / 3; border-radius: var(--radio); color: var(--c-primario); border: 1px solid color-mix(in srgb, var(--c-primario) 55%, transparent); background: color-mix(in srgb, var(--c-texto) 70%, #000); }
  .ficha-cuerpo { display: grid; gap: 3rem; }
  .ficha-detalle { max-width: 44rem; font-size: 1.1rem; }
  .ficha-detalle p + p { margin-top: 1.2rem; }
  .ficha-detalle p:first-child { font-size: 1.22rem; font-weight: 500; }
  .ficha-lado { display: grid; gap: 1.5rem; align-content: start; }
  .ficha-lado-titulo { margin-bottom: 1rem; color: var(--c-acento); }
  .ficha-datos { background: var(--panel); border: 1px solid var(--linea); border-radius: var(--radio); padding: 1.5rem; }
  .ficha-datos dl { display: grid; }
  .ficha-datos dl > div { display: flex; justify-content: space-between; gap: 1rem; padding: .8rem 0; border-top: 1px solid var(--linea); }
  .ficha-datos dt { font-family: var(--fuente-mono); font-size: .8rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; opacity: .7; }
  .ficha-datos dd { text-align: right; font-weight: 650; min-width: 0; overflow-wrap: anywhere; }
  .ficha-caja { display: grid; gap: .9rem; justify-items: start; border-radius: var(--radio); padding: 1.75rem 1.5rem; }
  .ficha-caja-titulo { font-size: 1.6rem; font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; }
  .ficha-tel { display: inline-flex; align-items: center; gap: .5rem; min-height: 2.75rem; font-family: var(--fuente-mono); font-weight: 700; color: inherit; text-decoration: none; }
  .ficha-galeria { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); }
  .ficha-galeria li { aspect-ratio: 4 / 3; border-radius: var(--radio); overflow: hidden; border: 1px solid var(--linea-oscura); }
  .ficha-otras { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); }
  .ficha-otra { position: relative; display: flex; flex-direction: column; gap: .6rem; padding: 1.4rem; border-radius: var(--radio); background: var(--panel); border: 1px solid var(--linea); transition: border-color .2s ease; }
  .ficha-otra:hover { border-color: var(--c-acento); }
  .ficha-otra-icono { display: inline-grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: var(--radio); background: var(--c-texto); color: var(--c-primario); }
  .ficha-otra h3 { font-size: 1.3rem; letter-spacing: -0.03em; line-height: 1.15; margin-top: .3rem; }
  .ficha-otra-enlace { text-decoration: none; color: inherit; }
  .ficha-otra-enlace::after { content: ""; position: absolute; inset: 0; border-radius: var(--radio); }
  .ficha-otra-enlace:focus-visible { outline: none; }
  .ficha-otra:has(.ficha-otra-enlace:focus-visible) { outline: 2px solid var(--c-acento); outline-offset: 2px; }
  .ficha-otra-texto { font-size: .95rem; opacity: .75; }
  .ficha-otra-pie { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: auto; padding-top: .5rem; font-size: 1.15rem; }
  .ficha-otra-ver { display: inline-flex; align-items: center; gap: .3rem; font-family: var(--fuente-mono); font-size: .8rem; font-weight: 700; text-transform: uppercase; color: var(--c-acento); }
  @media (min-width: 1024px) {
    .ficha-hero { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 4rem; }
    .ficha-cuerpo { grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 5rem; align-items: start; }
    .ficha-lado { position: sticky; top: 6.5rem; }
  }
</style>
