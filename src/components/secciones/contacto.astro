---
// Contacto: banda clara partida 50/50 a sangre. A la izquierda, titular y datos de site.yaml → contacto en filas
// (teléfono enorme en monoespaciada, WhatsApp, email, dirección con enlace al mapa y horario), cada uno con su icono
// en chip. A la derecha, `imagen` (la fachada) hasta el borde de la ventana con una etiqueta de la localidad. Si la
// sección «presupuesto» no está activa, en su lugar sale el formulario de contacto sobre negro.
import { seccion, site, tel, whatsapp, mapa } from '../../data/site';
import { altSeccion, localidad } from '../../lib/seo';
import Icono from '../ui/Icono.astro';
import Imagen from '../ui/Imagen.astro';
import FormularioContacto from '../ui/FormularioContacto.astro';
interface Props { id: string }
const { id } = Astro.props;
const s = seccion(id);
const c = site.contacto;
const conFormulario = !seccion('presupuesto');
const botonForm = (s?.boton_formulario as string) || undefined;
const lado = conFormulario || s?.imagen;
const loc = localidad();
---

{
  s && (
    <section id={id} class="banda-clara">
      <div class:list={['partida', lado ? (conFormulario ? '' : 'partida--md') : 'contacto--solo']}>
        <div class:list={['partida-texto', lado ? 'partida-texto--izq' : 'contenedor']}>
          {s.antetitulo && <p class="antetitulo">{s.antetitulo}</p>}
          {s.titulo && <h2 class="titulo-seccion">{s.titulo}</h2>}
          {s.texto && <p class="titular-texto">{s.texto}</p>}
          <ul class="contacto-datos">
            {c.telefono && (
              <li>
                <a class="dato dato--tel" href={tel(c.telefono)}>
                  <span class="dato-icono"><Icono nombre="telefono" tam={20} /></span>
                  <span class="num">{c.telefono}</span>
                </a>
              </li>
            )}
            {c.whatsapp && (
              <li>
                <a class="dato" href={whatsapp(c.whatsapp)} rel="noopener" target="_blank">
                  <span class="dato-icono"><Icono nombre="whatsapp" tam={20} /></span>
                  <span>WhatsApp {c.whatsapp}</span>
                </a>
              </li>
            )}
            {c.email && (
              <li>
                <a class="dato" href={`mailto:${c.email}`}>
                  <span class="dato-icono"><Icono nombre="correo" tam={20} /></span>
                  <span class="break-all">{c.email}</span>
                </a>
              </li>
            )}
            {c.direccion && (
              <li>
                <a class="dato" href={mapa(c.direccion)} rel="noopener" target="_blank">
                  <span class="dato-icono"><Icono nombre="mapa" tam={20} /></span>
                  <span>{c.direccion}</span>
                </a>
              </li>
            )}
            {c.horario && (
              <li>
                <p class="dato">
                  <span class="dato-icono"><Icono nombre="reloj" tam={20} /></span>
                  <span>{c.horario}</span>
                </p>
              </li>
            )}
          </ul>
        </div>
        {conFormulario ? (
          <div class="banda-negra puntos">
            <div class="partida-texto partida-texto--der">
              <FormularioContacto modelo="contacto" prefijo={`${id}-f`} boton={botonForm} />
            </div>
          </div>
        ) : (
          s.imagen && (
            <div class="partida-foto">
              <Imagen src={s.imagen} alt={altSeccion(s)} ancho={1200} alto={900} />
              {loc && <span class="chip contacto-loc"><span class="contacto-led" aria-hidden="true" />{loc}</span>}
            </div>
          )
        )}
      </div>
    </section>
  )
}

<style>
  .contacto--solo { grid-template-columns: 1fr !important; }
  .contacto-datos { display: grid; margin-top: 2.5rem; border-top: 1px solid var(--linea); }
  .dato { display: flex; align-items: center; gap: 1rem; min-height: 3.5rem; padding-block: .9rem; text-decoration: none; font-weight: 600; overflow-wrap: anywhere; border-bottom: 1px solid var(--linea); }
  .dato-icono { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; flex-shrink: 0; border-radius: var(--radio); background: var(--c-texto); color: var(--c-primario); }
  a.dato:hover > span:last-child { text-decoration: underline; }
  .dato--tel { font-size: clamp(1.9rem, 4.4vw, 3.5rem); line-height: 1; white-space: nowrap; overflow-wrap: normal; padding-block: 1.25rem; }
  .contacto-loc { position: absolute; left: 1rem; bottom: 1rem; padding: .5rem .8rem; background: var(--c-texto); color: var(--c-fondo); border-color: color-mix(in srgb, var(--c-primario) 50%, transparent); white-space: normal; }
  .contacto-led { width: .45rem; height: .45rem; border-radius: 50%; background: var(--c-primario); box-shadow: 0 0 8px var(--c-primario); }
</style>
