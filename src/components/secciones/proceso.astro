---
// Cómo trabajamos: banda verde a todo el ancho. Titular y, debajo, los pasos (`items: [{titulo, texto, icono}]`)
// como una barra de progreso: nodos «01», «02», «03» unidos por una línea (en móvil, en vertical). Al pie, la
// `galeria` (lista de fotos) en franja de borde a borde sin márgenes. Sin pasos ni fotos, solo el titular.
import { seccion } from '../../data/site';
import { altGaleria } from '../../lib/seo';
import Icono from '../ui/Icono.astro';
import Imagen from '../ui/Imagen.astro';
import Titular from '../ui/Titular.astro';
interface Props { id: string }
const { id } = Astro.props;
const s = seccion(id);
const pasos = s ? s.items.filter((it) => it && it.titulo) : [];
const fotos = s ? s.galeria.filter(Boolean).slice(0, 6) : [];
const dos = (n: number) => String(n).padStart(2, '0');
---

{
  s && (
    <section id={id} class="banda-neon">
      <div class="contenedor seccion">
        <div class="pro-cabecera">
          <Titular antetitulo={s.antetitulo} titulo={s.titulo} class="!mb-0" />
          {s.texto && <p class="pro-texto">{s.texto}</p>}
        </div>
        {pasos.length > 0 && (
          <ol class="pro-pasos" style={`--n:${pasos.length}`}>
            {pasos.map((p, i) => (
              <li class="pro-paso">
                <span class="pro-nodo num" aria-hidden="true">{dos(i + 1)}</span>
                <div>
                  <h3 class="pro-titulo">
                    {p.icono && <Icono nombre={p.icono} tam={26} class="shrink-0" />}
                    {p.titulo}
                  </h3>
                  {p.texto && <p class="mt-2 max-w-md opacity-85">{p.texto}</p>}
                </div>
              </li>
            ))}
          </ol>
        )}
      </div>
      {fotos.length > 0 && (
        <ul class="pro-fotos" style={`--f:${fotos.length}`}>
          {fotos.map((f, i) => (
            <li>
              <Imagen src={f} alt={altGaleria(i)} ancho={800} alto={600} class="h-full w-full object-cover" />
            </li>
          ))}
        </ul>
      )}
    </section>
  )
}

<style>
  .pro-cabecera { display: grid; gap: 1.5rem; margin-bottom: 3.5rem; }
  @media (min-width: 1024px) { .pro-cabecera { grid-template-columns: 1.4fr 1fr; align-items: end; gap: 5rem; } }
  .pro-texto { font-size: 1.2rem; font-weight: 600; max-width: 32rem; }
  .pro-pasos { position: relative; display: grid; gap: 2.5rem; }
  .pro-pasos::before { content: ""; position: absolute; left: 1.6rem; top: 1rem; bottom: 1rem; width: 2px; background: color-mix(in srgb, currentColor 35%, transparent); }
  .pro-paso { position: relative; display: grid; grid-template-columns: auto 1fr; gap: 1.25rem; align-items: start; }
  .pro-nodo { position: relative; display: grid; place-items: center; width: 3.2rem; height: 3.2rem; font-size: 1.15rem; border-radius: var(--radio); background: var(--c-texto); color: var(--c-primario); }
  .pro-titulo { display: flex; align-items: center; gap: .6rem; font-size: clamp(1.6rem, 3vw, 2.25rem); letter-spacing: -0.04em; }
  @media (min-width: 768px) {
    .pro-pasos { grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 2.5rem; }
    .pro-pasos::before { left: 0; right: 0; top: 1.6rem; bottom: auto; width: auto; height: 2px; }
    .pro-paso { grid-template-columns: 1fr; gap: 1.5rem; }
  }
  .pro-fotos { display: grid; grid-template-columns: repeat(var(--f), minmax(0, 1fr)); }
  .pro-fotos li { aspect-ratio: 3 / 4; overflow: hidden; background: var(--c-texto); }
  @media (min-width: 768px) { .pro-fotos li { aspect-ratio: 4 / 3; } }
</style>
