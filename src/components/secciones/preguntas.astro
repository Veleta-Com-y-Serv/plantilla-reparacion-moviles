---
// Preguntas frecuentes: banda clara a todo el ancho. Cabecera partida (titular a la izquierda; teléfono y
// WhatsApp de site.yaml → contacto a la derecha) y acordeón `details/summary` en dos columnas en escritorio con
// marcadores «[+]» / «[−]» monoespaciados (`preguntas: [{pregunta, respuesta}]`). Sin preguntas no se pinta.
import { seccion, site, tel, whatsapp } from '../../data/site';
import Icono from '../ui/Icono.astro';
import Titular from '../ui/Titular.astro';
interface Props { id: string }
const { id } = Astro.props;
const s = seccion(id);
const c = site.contacto;
const lista = s ? s.preguntas.filter((p) => p && p.pregunta) : [];
const mitad = Math.ceil(lista.length / 2);
const columnas = [lista.slice(0, mitad), lista.slice(mitad)].filter((col) => col.length);
---

{
  s && lista.length > 0 && (
    <section id={id} class="banda-clara seccion">
      <div class="contenedor">
        <div class="preg-cabecera">
          <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} class="!mb-0" />
          {(c.telefono || c.whatsapp) && (
            <div class="flex flex-wrap gap-3">
              {c.whatsapp && (
                <a class="btn btn-negro" href={whatsapp(c.whatsapp)} rel="noopener" target="_blank">
                  <Icono nombre="whatsapp" tam={18} />
                  WhatsApp
                </a>
              )}
              {c.telefono && (
                <a class="btn-sec" href={tel(c.telefono)}>
                  <Icono nombre="telefono" tam={18} />
                  {c.telefono}
                </a>
              )}
            </div>
          )}
        </div>
        <div class="preg-columnas">
          {columnas.map((col) => (
            <div class="preg-lista">
              {col.map((p) => (
                <details class="preg">
                  <summary>
                    <span>{p.pregunta}</span>
                    <span class="preg-marca" aria-hidden="true" />
                  </summary>
                  {p.respuesta && <p class="preg-respuesta">{p.respuesta}</p>}
                </details>
              ))}
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .preg-cabecera { display: grid; gap: 2rem; margin-bottom: 3rem; }
  @media (min-width: 1024px) { .preg-cabecera { grid-template-columns: minmax(0, 1.4fr) auto; align-items: end; gap: 4rem; } }
  .preg-columnas { display: grid; column-gap: 3rem; }
  @media (min-width: 1024px) { .preg-columnas { grid-template-columns: 1fr 1fr; align-items: start; } }
  .preg { border-top: 1px solid var(--linea); }
  .preg-lista .preg:last-child { border-bottom: 1px solid var(--linea); }
  @media (min-width: 1024px) { .preg-lista:first-child .preg:last-child { border-bottom: 1px solid var(--linea); } }
  .preg summary { display: flex; align-items: flex-start; justify-content: space-between; gap: 1.25rem; min-height: 3.5rem; padding-block: 1.3rem; cursor: pointer; list-style: none; font-family: var(--fuente-titulos); font-weight: 700; font-size: 1.2rem; letter-spacing: -0.02em; line-height: 1.3; }
  .preg summary::-webkit-details-marker { display: none; }
  .preg summary:hover { color: var(--c-acento); }
  .preg-marca::before { content: "[+]"; font-family: var(--fuente-mono); font-size: .95rem; font-weight: 700; color: var(--c-acento); white-space: nowrap; }
  .preg[open] .preg-marca::before { content: "[−]"; }
  .preg-respuesta { padding-bottom: 1.5rem; max-width: 40rem; opacity: .8; }
</style>
